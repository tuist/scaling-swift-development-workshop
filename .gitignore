# === Xcode / SwiftPM ===
# The Xcode project is generated by Tuist now. It is a build artefact, like a .o
# file — nobody merges those. This is the line that deletes a whole category of
# git conflict from your team's life.
app/*.xcodeproj
app/*.xcworkspace
app/Derived/
app/Tuist/.build/
app/.build/
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
.build/
build/
*.xcresult
*.xcactivitylog

# Swift Package Manager
.swiftpm/
Package.resolved.backup

# === Workshop runner ===
workshop/node_modules/
# Local, per-participant progress + measurements. Never committed.
.workshop/

# === macOS ===
.DS_Store
